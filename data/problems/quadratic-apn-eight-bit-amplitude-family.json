  "id": "quadratic-apn-eight-bit-amplitude-family",
  "group_id": "beneteau-quadratic-apn-walsh",
  "title": "Twelve unresolved eight-bit quadratic APN amplitude distributions",
  "summary": "Decide existence independently for twelve specified amplitude distributions of eight-bit quadratic APN functions.",
  "formal_statement": {
    "format": "markdown-latex",
    "body": "For every $i\\in\\{1,\\ldots,12\\}$, determine whether there exists a quadratic APN function $F:\\mathbb F_2^8\\to\\mathbb F_2^8$ with amplitude distribution $[0^{238-4i},2^{5i},4^{17-i}]$ in the notation of Definition I.3. The twelve targets are $[0^{234},2^5,4^{16}]$, $[0^{230},2^{10},4^{15}]$, $[0^{226},2^{15},4^{14}]$, $[0^{222},2^{20},4^{13}]$, $[0^{218},2^{25},4^{12}]$, $[0^{214},2^{30},4^{11}]$, $[0^{210},2^{35},4^{10}]$, $[0^{206},2^{40},4^9]$, $[0^{202},2^{45},4^8]$, $[0^{198},2^{50},4^7]$, $[0^{194},2^{55},4^6]$, and $[0^{190},2^{60},4^5]$."
  },
  "scope": {
    "domain": "Eight-bit quadratic APN functions and amplitude distributions",
    "assumptions": [
      "F : F_2^8 -> F_2^8 is quadratic and APN",
      "Amplitude notation uses Definition I.3 of the source",
      "Theorem IV.5 supplies the admissible distribution list"
    ],
    "parameters": [
      "integer i with 1 <= i <= 12"
    ],
    "unresolved_remainder": "All twelve instances remain unresolved: [0^234,2^5,4^16], [0^230,2^10,4^15], [0^226,2^15,4^14], [0^222,2^20,4^13], [0^218,2^25,4^12], [0^214,2^30,4^11], [0^210,2^35,4^10], [0^206,2^40,4^9], [0^202,2^45,4^8], [0^198,2^50,4^7], [0^194,2^55,4^6], and [0^190,2^60,4^5]. Each requires either a construction or a nonexistence proof."
  },
